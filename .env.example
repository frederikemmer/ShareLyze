# The external HTTPS origin, without a trailing path.
PUBLIC_ORIGIN=https://share.example.org
# Generate a random value, for example: openssl rand -hex 32
SETUP_TOKEN=
# Sources are defined only as read-only Compose mounts, e.g. /volume1/Fotos:/sources/Fotos:ro
# All application data lives here; individual subdirectories may also be mounted separately.
DATA_HOST_DIR=./data
# Optional: set a number of days to remove older analytics events.
ANALYTICS_RETENTION_DAYS=
# Optional: explicit IP/CIDR of the trusted reverse proxy, never arbitrary clients.
TRUSTED_PROXIES=
